class Solution {
    public int solution(String S) {
        // Implement your solution here
        Stack<Character> stack = new Stack<>();
        for(int i =0; i<S.length(); i++ ){
            if(S.charAt(i)=='['||S.charAt(i)=='{'||S.charAt(i)=='('){
                stack.add(S.charAt(i));
            }
            
            if(S.charAt(i)==']'){
                if(stack.isEmpty()){
                    return 0;
               
            }
                if(stack.peek()=='['){
                    stack.pop();
                }
            }
            if(S.charAt(i)=='}'){
                if(stack.isEmpty()){
                    return 0;
               
            }
                if(stack.peek()=='{'){
                    stack.pop();
                }
            }
            if(S.charAt(i)==')'){
                if(stack.isEmpty()){
                    return 0;
               
            }
                if(stack.peek()=='('){
                    stack.pop();
                }
            }
        }
        if(stack.isEmpty()){
            return 1;
        }else{
            return 0;
        }
    }
}
